#!/usr/bin/env bash
# Capture AWS RDS into dumps/jobstrainer.current.dump, then tofu destroy.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/common.sh
source "${SCRIPT_DIR}/lib/common.sh"
# shellcheck source=lib/aws.sh
source "${SCRIPT_DIR}/lib/aws.sh"

usage() {
  cat <<'EOF'
Usage: demo-down-aws [--yes]

  --yes   Pass -auto-approve to tofu destroy

Dumps RDS into dumps/jobstrainer.current.dump (archiving any previous
current), then destroys the AWS OpenTofu stack. Aborts destroy if
dump/validate/promote fails. Does not change Cloudflare/Hetzner DNS.

EOF
}

auto_approve=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    --yes)
      auto_approve=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "error: unknown argument: $1" >&2
      usage >&2
      exit 1
      ;;
  esac
done

aws_require_tools
require_pg_client
aws_require_tfvars

if ! aws_stack_reachable; then
  echo "error: AWS stack outputs unavailable in ${AWS_DIR}" >&2
  echo "hint: run tofu apply / demo-up-aws first" >&2
  exit 1
fi

tmp="$(mktemp_dump)"
trap 'rm -f "${tmp}"; aws_resume_writers 2>/dev/null || true' EXIT

aws_pause_writers

echo "==> dumping RDS → S3 → temp"
aws_run_dump_task
aws_download_dump "${tmp}"

echo "==> validating and promoting"
promote_dump "${tmp}"
trap 'aws_resume_writers 2>/dev/null || true' EXIT

tofu_args=(destroy)
if [[ "${auto_approve}" -eq 1 ]]; then
  tofu_args+=(-auto-approve)
fi

echo "==> tofu destroy (${AWS_DIR})"
(
  cd "${AWS_DIR}"
  tofu "${tofu_args[@]}"
)

trap - EXIT
# Stack is gone; skip resume.
_AWS_WRITERS_PAUSED=0

echo "demo-down-aws complete. Canonical dump: ${CURRENT_DUMP}"
echo "Spot-check AWS console: NAT, EIP, ALB, RDS, OpenSearch, S3 dump bucket."
