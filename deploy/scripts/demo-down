#!/usr/bin/env bash
# Capture Hetzner Postgres into dumps/jobstrainer.current.dump, then tofu destroy.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/common.sh
source "${SCRIPT_DIR}/lib/common.sh"

usage() {
  cat <<'EOF'
Usage: demo-down [--yes]

  --yes   Pass -auto-approve to tofu destroy

Dumps cloud Postgres into dumps/jobstrainer.current.dump (archiving any
previous current), then destroys Hetzner infra. Aborts destroy if dump/promote
fails. Prefer this over bare tofu destroy when the demo holds data.

EOF
}

auto_approve=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    --yes)
      auto_approve=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "error: unknown argument: $1" >&2
      usage >&2
      exit 1
      ;;
  esac
done

require_cmd tofu
require_pg_client
ensure_kubeconfig

tmp="$(mktemp_dump)"
trap 'rm -f "${tmp}"' EXIT

echo "==> dumping ${POSTGRES_POD} → temp"
cluster_pg_dump_to "${tmp}"

echo "==> validating and promoting"
promote_dump "${tmp}"
trap - EXIT

tofu_args=(destroy)
if [[ "${auto_approve}" -eq 1 ]]; then
  tofu_args+=(-auto-approve)
fi

echo "==> tofu destroy (${HETZNER_DIR})"
(
  cd "${HETZNER_DIR}"
  tofu "${tofu_args[@]}"
)

echo "demo-down complete. Canonical dump: ${CURRENT_DUMP}"
